# Frontend (browser) — base URL of the API. Defaults to same-origin "/api" when unset,
# which is what the Docker/nginx deployment uses. For local dev against the API on :3000:
VITE_API_URL=http://localhost:3000/api

# Backend (server/) — used by the Node API and the db:migrate/db:seed scripts.
DATABASE_URL=postgres://user:password@host:5432/database
JWT_SECRET=change-me-to-a-long-random-string
PORT=3000
# Comma-separated list of allowed browser origins for CORS (needed only when the API is
# served from a different origin than the frontend, e.g. local dev).
CORS_ORIGINS=http://localhost:5173

# --- Docker Compose (docker compose reads a root .env automatically) ---
POSTGRES_USER=qa
POSTGRES_PASSWORD=qa_password
POSTGRES_DB=qa_dashboard
# Host port the dashboard is published on (http://<host>:<HOST_PORT>).
HOST_PORT=8080
# Set to /app/db/seed.sql to load sample weeks/projects/data on first boot; leave empty to skip.
SEED_FILE=
