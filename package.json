{
  "name": "qa-weekly-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "NODE_OPTIONS=--max-old-space-size=8192 vitest run",
    "test:watch": "NODE_OPTIONS=--max-old-space-size=8192 vitest",
    "coverage": "NODE_OPTIONS=--max-old-space-size=8192 vitest run --coverage",
    "db:migrate": "node scripts/db/execute.mjs db/migrations/001_initial_schema.sql",
    "db:seed": "node scripts/db/execute.mjs db/seed.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.7.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.37.0",
    "@typescript-eslint/parser": "^8.37.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.31.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "pg": "^8.16.3",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  }
}
